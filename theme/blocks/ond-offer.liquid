{{ 'ondelune-5.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = closest.product
  assign cur = p.selected_or_first_available_variant
  assign unit = cur.price
-%}
{%- if p != blank -%}
<style>
  body:has(ond-offer:not([data-qty="1"])) .accelerated-checkout-block{display:none!important}
  @media screen and (max-width:749px){
    .sticky-add-to-cart__bar .add-to-cart-text__content{display:inline!important}
    .sticky-add-to-cart__bar .sticky-add-to-cart__button{width:auto!important;padding-inline:16px!important;white-space:nowrap}
    .sticky-add-to-cart__bar .sticky-add-to-cart__button .svg-wrapper{display:none}
  }
</style>
<ond-offer class="ond-offer" data-section="{{ section.id }}" data-qty="1" {{ block.shopify_attributes }}>
  <fieldset class="ond-offer__set">
    <legend class="ond-offer__legend">{{ block.settings.heading | escape }}</legend>
    {%- for q in (1..3) -%}
      {%- liquid
        case q
          when 1
            assign pct = 0
            assign title = block.settings.t1_title
            assign sub = block.settings.t1_sub
            assign tag = ''
          when 2
            assign pct = block.settings.t2_pct
            assign title = block.settings.t2_title
            assign sub = block.settings.t2_sub
            assign tag = block.settings.t2_tag
          when 3
            assign pct = block.settings.t3_pct
            assign title = block.settings.t3_title
            assign sub = block.settings.t3_sub
            assign tag = ''
        endcase
        assign full = unit | times: q
        assign keep = 100 | minus: pct
        assign now = full | times: keep | divided_by: 100
        assign each = now | divided_by: q
      -%}
      {%- if q == 1 or pct > 0 and block.settings.show_packs -%}
      <div data-label="{{ title | escape }}" class="ond-offer__opt ond-offer__opt--q{{ q }}{% if q == 1 %} is-active{% endif %}{% if q == 3 %} is-minor{% endif %}">
        <label class="ond-offer__head">
          <input type="radio" name="ond-offer-{{ block.id }}" value="{{ q }}" {% if q == 1 %}checked{% endif %}>
          <span class="ond-offer__radio" aria-hidden="true"></span>
          <span class="ond-offer__main">
            <span class="ond-offer__title">{{ title | escape }}{% if pct > 0 %}<span class="ond-offer__save">−{{ pct }} %</span>{% endif %}{% if tag != blank %}<span class="ond-offer__tag">{{ tag | escape }}</span>{% endif %}</span>
            <span class="ond-offer__sub">{% if sub != blank %}{{ sub | escape }}{% endif %}{% if q > 1 %}{% if sub != blank %} · {% endif %}{{ each | money }} l'unité{% endif %}</span>
          </span>
          <span class="ond-offer__price">
            <span class="ond-offer__now">{{ now | money }}</span>
            {%- if pct > 0 -%}<s class="ond-offer__was"><span class="ond-sr">Au lieu de </span>{{ full | money }}</s>{%- endif -%}
          </span>
        </label>
        {%- if q > 1 -%}
        <div class="ond-offer__colors" hidden>
          <p class="ond-offer__hint">{{ block.settings.colors_hint | escape }}</p>
          {%- for i in (1..q) -%}
          <fieldset class="ond-offer__row" data-i="{{ i }}">
            <legend>Instrument {{ i }} <span data-name>· {{ cur.title | escape }}</span></legend>
            <div class="ond-offer__dots">
              {%- for v in p.variants -%}
              <label class="ond-dot">
                <input type="radio" name="ond-{{ block.id }}-q{{ q }}-i{{ i }}" value="{{ v.id }}" data-name="{{ v.title | escape }}" {% if v.id == cur.id %}checked{% endif %}{% unless v.available %} disabled{% endunless %}>
                <span class="ond-dot__swatch" data-color="{{ v.title | handleize }}" aria-hidden="true"></span>
                <span class="ond-sr">{{ v.title | escape }}{% unless v.available %} (indisponible){% endunless %}</span>
              </label>
              {%- endfor -%}
            </div>
          </fieldset>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endfor -%}
  </fieldset>
  {%- if block.settings.note != blank and block.settings.show_packs -%}<p class="ond-offer__note">{{ block.settings.note | escape }}</p>{%- endif -%}
  <p class="ond-offer__msg" role="status" aria-live="polite" hidden></p>
</ond-offer>
<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';
  if (!customElements.get('ond-offer')) {
    customElements.define('ond-offer', class extends HTMLElement {
      connectedCallback() {
        if (this._ready) return; this._ready = true;
        this.section = document.getElementById('shopify-section-' + this.dataset.section);
        this.pf = this.section?.querySelector('product-form-component');
        this.addEventListener('change', (e) => this.onChange(e));
        this.pf?.addEventListener('submit', (e) => this.onSubmit(e), true);
        this.section?.addEventListener('change', (e) => {
          const t = e.target;
          if (t instanceof HTMLInputElement && t.closest('variant-picker') && t.dataset.variantId) this.followMain(t.dataset.variantId);
        });
        this.sync();
        const st = this.section?.querySelector('sticky-add-to-cart [ref="stickyBar"]');
        if (st) new MutationObserver(() => { if (!this._applying && this.qty() > 1) requestAnimationFrame(() => this.updateSticky()); }).observe(st, { childList: true, subtree: true, characterData: true });
      }
      mainName() {
        return this.section?.querySelector('variant-picker input:checked')?.value || '';
      }
      updateSticky() {
        const st = this.section?.querySelector('sticky-add-to-cart'); if (!st) return;
        const priceEl = st.querySelector('.sticky-add-to-cart__price');
        const varEl = st.querySelector('.sticky-add-to-cart__variant');
        const qNum = st.querySelector('[ref="quantityNumber"]');
        const qDisp = st.querySelector('[ref="quantityDisplay"]');
        const q = this.qty();
        this._applying = true;
        if (q > 1) {
          const opt = this.querySelector('.ond-offer__opt--q' + q);
          const total = opt.querySelector('.ond-offer__now').textContent.trim();
          const names = [...opt.querySelectorAll('.ond-offer__row input:checked')].map((i) => i.dataset.name);
          const cnt = {}; names.forEach((n) => { cnt[n] = (cnt[n] || 0) + 1; });
          const label = opt.dataset.label + ' · ' + Object.entries(cnt).map(([n, c]) => (c > 1 ? c + ' × ' : '') + n).join(' + ');
          if (priceEl && priceEl.textContent.trim() !== total) { priceEl.textContent = total; priceEl.dataset.ondPack = '1'; }
          if (varEl && varEl.textContent.trim() !== label) { varEl.textContent = label; varEl.dataset.ondPack = '1'; }
          if (qNum && qNum.textContent !== String(q)) qNum.textContent = String(q);
          if (qDisp) qDisp.style.display = 'inline';
        } else {
          if (priceEl?.dataset.ondPack) { priceEl.textContent = this.querySelector('.ond-offer__opt--q1 .ond-offer__now').textContent.trim(); delete priceEl.dataset.ondPack; }
          if (varEl?.dataset.ondPack) { varEl.textContent = this.mainName(); delete varEl.dataset.ondPack; }
          if (qNum) qNum.textContent = '1';
          if (qDisp) qDisp.style.display = 'none';
        }
        requestAnimationFrame(() => { this._applying = false; });
      }
      qty() { return Number(this.querySelector('input[name^="ond-offer-"]:checked')?.value || 1); }
      onChange(e) {
        const t = e.target;
        if (!(t instanceof HTMLInputElement)) return;
        if (t.name.startsWith('ond-offer-')) this.sync();
        else { t.closest('.ond-offer__row')?.setAttribute('data-touched', ''); this.names(); }
      }
      sync() {
        this.querySelectorAll('.ond-offer__opt').forEach((o) => {
          const on = o.querySelector('input[name^="ond-offer-"]').checked;
          o.classList.toggle('is-active', on);
          const c = o.querySelector('.ond-offer__colors'); if (c) c.hidden = !on;
        });
        this.dataset.qty = String(this.qty());
        this.msg('');
        this.names();
      }
      followMain(id) {
        this.querySelectorAll('.ond-offer__row[data-i="1"]:not([data-touched])').forEach((r) => {
          const i = r.querySelector('input[value="' + id + '"]'); if (i && !i.disabled) i.checked = true;
        });
        this.names();
      }
      names() {
        this.querySelectorAll('.ond-offer__row').forEach((r) => {
          const c = r.querySelector('input:checked'); const n = r.querySelector('[data-name]');
          if (n) n.textContent = c ? '· ' + c.dataset.name : '';
        });
        this.updateSticky();
      }
      msg(text, error) {
        const m = this.querySelector('.ond-offer__msg'); if (!m) return;
        m.textContent = text; m.hidden = !text; m.classList.toggle('is-error', !!error);
      }
      busy(on) {
        this.pf?.querySelectorAll('button[type="submit"], [ref="addToCartButton"]').forEach((b) => { b.disabled = on; });
        this.setAttribute('aria-busy', on ? 'true' : 'false');
      }
      async refreshCart() {
        const c = document.querySelector('cart-items-component');
        if (c) {
          try { await customElements.whenDefined('cart-items-component'); return await c.fetchCartData(); } catch (e) { /* repli ci-dessous */ }
        }
        const r = await fetch(Theme.routes.cart_url + '.js', { headers: { Accept: 'application/json' } });
        return r.json();
      }
      async onSubmit(e) {
        const q = this.qty();
        if (q < 2) return;
        e.preventDefault(); e.stopImmediatePropagation();
        if (this.getAttribute('aria-busy') === 'true') return;
        const opt = this.querySelector('.ond-offer__opt--q' + q);
        const ids = [...opt.querySelectorAll('.ond-offer__row input:checked')].map((i) => i.value);
        if (ids.length !== q) { this.msg('Choisissez un coloris pour chaque instrument.', true); return; }
        const counts = {}; ids.forEach((id) => { counts[id] = (counts[id] || 0) + 1; });
        const items = Object.entries(counts).map(([id, quantity]) => ({ id: Number(id), quantity }));
        const sections = [...document.querySelectorAll('cart-items-component')].map((c) => c.dataset.sectionId).filter(Boolean).join(',');
        const deferred = CartLinesUpdateEvent.createPromise();
        deferred.promise.catch(() => {});
        this.pf.dispatchEvent(new CartLinesUpdateEvent({ action: 'add', context: 'product', lines: items.map((i) => ({ merchandiseId: String(i.id), quantity: i.quantity })), promise: deferred.promise }));
        this.busy(true);
        this.msg('');
        let res;
        try {
          const r = await fetch(Theme.routes.cart_add_url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items, sections }) });
          res = await r.json();
        } catch (err) {
          deferred.reject(err);
          this.msg("La connexion a été interrompue. Vérifiez votre panier avant de réessayer : les articles déjà ajoutés y restent.", true);
          this.busy(false);
          return;
        }
        let cart = null;
        try { cart = await this.refreshCart(); } catch (err) { cart = null; }
        if (res && res.status) {
          if (cart) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: true, items: cart.items, source: 'ond-offer' } });
          else deferred.reject(new Error(res.message || 'add failed'));
          this.pf.dispatchEvent(new CartErrorEvent({ error: res.message || 'Add to cart failed', code: 'INVALID' }));
          this.msg((res.description || res.message || "L'ajout au panier n'a pas abouti.") + ' Votre panier est inchangé.', true);
          this.busy(false);
          return;
        }
        if (cart) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { items: cart.items, source: 'ond-offer', itemCount: q, sections: res.sections, didError: false } });
        else deferred.reject(new Error('cart refresh failed'));
        this.msg(q + ' Ondelune Mini ajoutés au panier. La remise apparaît dans le panier.');
        this.busy(false);
      }
    });
  }
</script>
{%- endif -%}
{% schema %}
{"name":"Ondelune – Offres","settings":[{"type":"text","id":"heading","label":"Titre","default":"Votre offre"},{"type":"checkbox","id":"show_packs","label":"Afficher les offres duo et trio","default":true},{"type":"header","content":"1 instrument (choix par défaut)"},{"type":"text","id":"t1_title","label":"Titre","default":"1 Ondelune Mini"},{"type":"text","id":"t1_sub","label":"Sous-titre","default":"Pour vous ou à offrir"},{"type":"header","content":"Duo"},{"type":"range","id":"t2_pct","label":"Remise affichée (%) – identique à la réduction automatique Shopify","min":0,"max":40,"step":1,"default":10},{"type":"text","id":"t2_title","label":"Titre","default":"Duo"},{"type":"text","id":"t2_sub","label":"Sous-titre","default":"Un pour vous, un à offrir"},{"type":"text","id":"t2_tag","label":"Étiquette","default":"Idéal pour offrir"},{"type":"header","content":"Trio"},{"type":"range","id":"t3_pct","label":"Remise affichée (%) – identique à la réduction automatique Shopify","min":0,"max":40,"step":1,"default":15},{"type":"text","id":"t3_title","label":"Titre","default":"Trio"},{"type":"text","id":"t3_sub","label":"Sous-titre","default":"Pour toute la famille"},{"type":"text","id":"colors_hint","label":"Consigne coloris","default":"Choisissez le coloris de chaque instrument."},{"type":"textarea","id":"note","label":"Note sous les offres","default":"La remise duo ou trio s'applique automatiquement dans le panier, selon le nombre total d'instruments."}],"presets":[{"name":"Ondelune – Offres"}]}
{% endschema %}
