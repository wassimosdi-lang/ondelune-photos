{%- if block.settings.enabled -%}
<div class="ond-xmas" data-deadline="{{ block.settings.deadline }}" data-start="{{ block.settings.countdown_from }}" {{ block.shopify_attributes }}>
  <style>
    .ond-xmas{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border-radius:12px;background:#f3efe6;color:#252825;font-size:14px;line-height:1.45}
    .ond-xmas[hidden]{display:none}
    .ond-xmas svg{flex:0 0 20px;width:20px;height:20px;color:#34483F;margin-top:1px}
    .ond-xmas strong{display:block}
    .ond-xmas__timer{display:inline-flex;gap:6px;margin-top:6px}
    .ond-xmas__timer span{background:#fff;border-radius:8px;padding:3px 8px;font-weight:600;font-variant-numeric:tabular-nums;font-size:13px}
  </style>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="18" height="12" rx="1.5"/><path d="M2 9h20M12 9v12M12 9c-2-4-6-4-5-1 1 1 3 1 5 1zM12 9c2-4 6-4 5-1-1 1-3 1-5 1z"/></svg>
  <span>
    <strong>{{ block.settings.heading | escape }}</strong>
    <span class="ond-xmas__calm">{{ block.settings.calm_text | escape }}</span>
    <span class="ond-xmas__rush" hidden>{{ block.settings.rush_text | escape }}<br><span class="ond-xmas__timer" role="timer"><span data-d></span><span data-h></span><span data-m></span></span></span>
  </span>
</div>
<script>
(function(){var el=document.currentScript.previousElementSibling;if(!el)return;
var dl=new Date(el.dataset.deadline),st=new Date(el.dataset.start);
var calm=el.querySelector('.ond-xmas__calm'),rush=el.querySelector('.ond-xmas__rush'),tm=el.querySelector('.ond-xmas__timer');
function p(n){return n<10?'0'+n:''+n}
function tick(){var now=new Date();if(!isNaN(dl)&&now>dl){el.hidden=true;return false;}
 var r=!isNaN(st)&&!isNaN(dl)&&now>=st;calm.hidden=r;rush.hidden=!r;if(!r)return true;
 var s=Math.floor((dl-now)/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);
 tm.querySelector('[data-d]').textContent=d+' j';tm.querySelector('[data-h]').textContent=p(h)+' h';tm.querySelector('[data-m]').textContent=p(m)+' min';return true;}
if(tick())setInterval(tick,30000);})();
</script>
{%- endif -%}
{% schema %}
{"name":"Ondelune – Saison (Noël)","settings":[{"type":"checkbox","id":"enabled","label":"Afficher le message saisonnier","default":true},{"type":"text","id":"heading","label":"Titre","default":"Une idée pour Noël"},{"type":"text","id":"calm_text","label":"Texte","default":"Livré avec tous ses accessoires : on peut en jouer dès l'ouverture du colis."},{"type":"text","id":"rush_text","label":"Texte pendant le compte à rebours","default":"Il reste peu de temps pour le recevoir avant Noël :"},{"type":"text","id":"countdown_from","label":"Début du compte à rebours (AAAA-MM-JJTHH:MM:SS+01:00)","default":"2026-12-01T00:00:00+01:00"},{"type":"text","id":"deadline","label":"Fin (le bloc disparaît ensuite)","default":"2026-12-10T23:59:00+01:00"}],"presets":[{"name":"Ondelune – Saison (Noël)"}]}
{% endschema %}
