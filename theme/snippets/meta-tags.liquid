{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#34483F"
>

{%- liquid
  assign ond_default_description = "Ondelune Mini : un tongue drum en acier de 16 cm à 11 notes, dont on joue sans solfège dès la première minute. Maillets, livret et housse inclus, 6 coloris."
  assign ond_description = page_description
  if ond_description == blank and request.page_type == 'page'
    case page.handle
      when 'relaxation'
        assign ond_description = "Quelques minutes, quelques notes : l'Ondelune Mini est un petit tongue drum en acier qu'on joue du bout des doigts, sans solfège."
      when 'cadeau'
        assign ond_description = "Une idée cadeau originale : l'Ondelune Mini, tongue drum en acier de 16 cm, se joue sans savoir jouer. Maillets, livret et housse inclus."
      when 'decouverte'
        assign ond_description = "Découvrir la musique sans solfège avec l'Ondelune Mini : 11 notes accordées pour sonner ensemble, à jouer avec les doigts ou les maillets."
    endcase
  endif
  if ond_description == blank and request.page_type == 'index'
    assign ond_description = ond_default_description
  endif

  assign og_title = page_title | default: shop.name
  assign ond_title = page_title
  if request.page_type == 'index' and page_title == shop.name
    assign ond_title = 'Ondelune – Tongue drum en acier qui se joue sans solfège'
    assign og_title = ond_title
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = ond_description | default: shop.description | default: ond_default_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- else -%}
  <meta
    property="og:image"
    content="https:{{ 'ond-share.jpg' | asset_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ 'ond-share.jpg' | asset_url }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="630"
  >
  <meta
    property="og:image:alt"
    content="Ondelune Mini, tongue drum en acier de 16 cm à 11 notes"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ ond_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless ond_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if ond_description != blank %}
  <meta
    name="description"
    content="{{ ond_description | escape }}"
  >
{% endif %}
