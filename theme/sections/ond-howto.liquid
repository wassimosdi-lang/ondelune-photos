{{ 'ondelune-5.css' | asset_url | stylesheet_tag }}
<style>@media screen and (max-width:749px){.ond-steps{grid-template-columns:1fr!important}}</style>
{%- assign auto_icons = 'poser,effleurer,resonner,facile' | split: ',' -%}
<section class="ond ond-section ond-bg-{{ section.settings.bg }}">
  <div class="ond-wrap">
    <div class="ond-head{% if section.settings.style != 'plain' %} ond-center{% endif %}" style="max-width:760px{% if section.settings.style != 'plain' %};margin-inline:auto{% endif %}">
      <h2 class="ond-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ond-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="ond-steps{% if section.settings.style == 'plain' %} ond-steps--plain{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign ic = block.settings.icon | default: 'auto' -%}
        {%- if ic == 'auto' -%}{%- assign ic = auto_icons[forloop.index0] -%}{%- endif -%}
        <div class="ond-step" {{ block.shopify_attributes }}>
          <div class="ond-step__top">
            <div class="ond-step__n">{{ forloop.index | prepend: '0' }}</div>
            {%- if ic != 'none' and ic != blank -%}<img class="ond-icon" src="{{ 'ond-ic-' | append: ic | append: '.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">{%- endif -%}
          </div>
          <h3 class="ond-h3">{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}<p style="margin-top:32px"><a class="ond-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Ondelune – Comment jouer","settings":[{"type":"text","id":"heading","label":"Titre","default":"Trois gestes, et la musique commence"},{"type":"textarea","id":"text","label":"Texte"},{"type":"select","id":"style","label":"Présentation","options":[{"value":"cards","label":"Cartes"},{"value":"plain","label":"Épurée"}],"default":"plain"},{"type":"text","id":"button_label","label":"Bouton"},{"type":"url","id":"button_link","label":"Lien"},{"type":"select","id":"bg","label":"Fond","options":[{"value":"ivory","label":"Ivoire"},{"value":"beige","label":"Beige"},{"value":"white","label":"Blanc"}],"default":"ivory"}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"select","id":"icon","label":"Icône","options":[{"value":"auto","label":"Automatique"},{"value":"none","label":"Aucune"},{"value":"poser","label":"Poser"},{"value":"effleurer","label":"Effleurer"},{"value":"resonner","label":"Résonner"},{"value":"facile","label":"Note de musique"},{"value":"pause","label":"Lune"},{"value":"cadeau","label":"Cadeau"}],"default":"auto"},{"type":"text","id":"title","label":"Titre"},{"type":"textarea","id":"text","label":"Texte"}]}],"max_blocks":4,"presets":[{"name":"Ondelune – Comment jouer","blocks":[{"type":"step","settings":{"title":"Posez-le","text":"Sur vos genoux, une table ou un coussin."}},{"type":"step","settings":{"title":"Effleurez les notes","text":"Du bout des doigts pour un son doux, avec les maillets pour un son plus présent."}},{"type":"step","settings":{"title":"Laissez résonner","text":"Les notes s'accordent entre elles : enchaînez-les à votre rythme."}}]}]}
{% endschema %}
