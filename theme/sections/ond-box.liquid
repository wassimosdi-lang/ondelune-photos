{{ 'ondelune.css' | asset_url | stylesheet_tag }}
{{ 'ondelune-5.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign hp = section.settings.product
  if hp == blank
    assign hp = collections.all.products.first
  endif
  assign img = section.settings.image
  if img == blank and hp != blank
    assign idx = section.settings.media_position | minus: 1
    assign img = hp.images[idx] | default: hp.featured_image
  endif
-%}
<section class="ond ond-section ond-bg-{{ section.settings.bg }}">
  <div class="ond-wrap ond-box">
    <div class="ond-box__media">
      {%- if img != blank -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 750px) 55vw, 100vw', alt: img.alt }}{%- endif -%}
    </div>
    <div>
      <h2 class="ond-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ond-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <ul class="ond-box__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.detail != blank %}<span>{{ block.settings.detail | escape }}</span>{% endif %}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% schema %}
{"name":"Ondelune – Coffret","settings":[{"type":"text","id":"heading","label":"Titre","default":"Ce que vous recevez"},{"type":"textarea","id":"text","label":"Texte"},{"type":"image_picker","id":"image","label":"Image (sinon photo du produit)"},{"type":"product","id":"product","label":"Produit (sinon le premier de la boutique)"},{"type":"range","id":"media_position","label":"Photo du produit n°","min":1,"max":12,"step":1,"default":5},{"type":"select","id":"bg","label":"Fond","options":[{"value":"ivory","label":"Ivoire"},{"value":"beige","label":"Beige"},{"value":"white","label":"Blanc"}],"default":"white"}],"blocks":[{"type":"item","name":"Élément","settings":[{"type":"text","id":"title","label":"Élément"},{"type":"text","id":"detail","label":"Précision"}]}],"presets":[{"name":"Ondelune – Coffret"}]}
{% endschema %}
