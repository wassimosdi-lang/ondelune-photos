{{ 'ondelune.css' | asset_url | stylesheet_tag }}
{{ 'ondelune-5.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign hp = section.settings.product
  if hp == blank
    assign hp = collections.all.products.first
  endif
  assign img = section.settings.image
  if img == blank and hp != blank
    assign idx = section.settings.media_position | minus: 1
    assign img = hp.images[idx] | default: hp.featured_image
  endif
-%}
<section class="ond ond-section ond-bg-{{ section.settings.bg }}">
  <div class="ond-wrap">
    <div class="ond-gift">
      <div class="ond-gift__media">
        {%- if img != blank -%}{{ img | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', sizes: '(min-width: 750px) 50vw, 100vw', alt: img.alt }}{%- endif -%}
      </div>
      <div class="ond-gift__body">
        <h2 class="ond-h2" style="margin:0">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.points != blank -%}
          {%- assign pts = section.settings.points | newline_to_br | split: '<br />' -%}
          <ul class="ond-gift__points">{%- for c in pts -%}{%- assign c2 = c | strip -%}{%- if c2 != blank -%}<li>{{ c2 | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
        {%- endif -%}
        {%- if section.settings.show_season and section.settings.season_text != blank -%}<p class="ond-gift__season">{{ section.settings.season_text | escape }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a class="ond-btn ond-btn--light" href="{{ section.settings.button_link | default: hp.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Ondelune – Cadeau","settings":[{"type":"text","id":"heading","label":"Titre","default":"Un cadeau qui se découvre en musique"},{"type":"textarea","id":"text","label":"Texte"},{"type":"textarea","id":"points","label":"Points (un par ligne)"},{"type":"checkbox","id":"show_season","label":"Afficher le message saisonnier","default":false},{"type":"text","id":"season_text","label":"Message saisonnier","default":"Pour Noël : livré avec tous ses accessoires."},{"type":"image_picker","id":"image","label":"Image (sinon photo du produit)"},{"type":"product","id":"product","label":"Produit (sinon le premier de la boutique)"},{"type":"range","id":"media_position","label":"Photo du produit n°","min":1,"max":12,"step":1,"default":3},{"type":"text","id":"button_label","label":"Bouton"},{"type":"url","id":"button_link","label":"Lien du bouton"},{"type":"select","id":"bg","label":"Fond","options":[{"value":"ivory","label":"Ivoire"},{"value":"beige","label":"Beige"},{"value":"white","label":"Blanc"}],"default":"ivory"}],"presets":[{"name":"Ondelune – Cadeau"}]}
{% endschema %}
